# ---------- 服务绑定 ----------
# 本机开发用 127.0.0.1；手机/局域网访问改成 0.0.0.0（见 README 的 Tailscale 一节）
BIND_HOST=127.0.0.1
BIND_PORT=8787

# ---------- 数据目录 ----------
# 默认是本项目下的 data/（运行时数据：索引、偏好库、lolibrary 档案、xhs 会话）。
# 想把运行时数据放到另一块盘就改这里。注意：改完要重新跑一次 build_kb_index.py。
# 自有知识库在 content/kb 下（进 git），要挪位置用 CONTENT_DIR。

# ---------- 上游知识管线 ----------
# 复用 lolita-rag 的 清洗/切分/BGE/混合检索/闸门/verify，不复制代码
# 默认是同级目录 ../lolita-rag；放在别处就改成你本机的真实路径
LOLITA_RAG_ROOT=../lolita-rag

# ---------- LLM（规划器 + 写作器都靠它）----------
# 留空时 /api/chat 返回 503 并说明怎么配。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- 检索 ----------
# 单通道取最相关的几条；多路召回在结果层合并，答案里的 [n] 引用与合并后的条目一一对应。
TOP_K=1

# ---------- 召回通道：小红书（可选）----------
# XHS_PROVIDER=playwright 时：先装 playwright，跑 python scripts/xhs_search.py --login 扫码登录。
# XHS_PROVIDER=spider_xhs 时：clone Spider_XHS 到同级目录，pip/npm 装依赖后填 XHS_COOKIE。
XHS_ENABLED=false
XHS_TIMEOUT=45
XHS_PROVIDER=playwright
# Spider_XHS 外部仓库路径（默认 ../Spider_XHS，不进本仓 git）
XHS_SPIDER_ROOT=../Spider_XHS
# 小红书登录 Cookie（需含 a1 + web_session，从浏览器请求头完整复制）
XHS_COOKIE=

# ---------- 召回通道：网页 / 微博（可选）----------
# 填了 key 才启用（weibo 通道 = 网页搜索限定微博域；web 通道 = 普通网页搜索）。
SEARCH_ENABLED=false
SEARCH_API_KEY=
# 博查 bocha（默认）或智谱 zhipu
SEARCH_PROVIDER=bocha
SEARCH_BASE_URL=
SEARCH_ENGINE=search_std
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=20
