# ---------- 服务绑定 ----------
# 本机开发用 127.0.0.1；手机/局域网访问改成 0.0.0.0（见 README 的 Tailscale 一节）
BIND_HOST=127.0.0.1
BIND_PORT=8787

# ---------- 数据目录 ----------
# 默认是本项目下的 data/（运行时数据：索引、用户数据库、lolibrary 档案、xhs 会话）。
# 想把运行时数据放到另一块盘就改这里。注意：改完要重新跑一次 build_kb_index.py。
# 自有知识库默认在 content/kb 下（进 git）；要挪位置改 CONTENT_DIR（指向 content 根目录）。
# CONTENT_DIR=content

# ---------- 上游知识管线 ----------
# 复用 lolita-rag 的 清洗/切分/BGE/混合检索/闸门/verify，不复制代码
# 默认是同级目录 ../lolita-rag；放在别处就改成你本机的真实路径。
# 必须是固定的 checkout，不要指向临时工作目录：被清理后两份索引都会建不出来。
LOLITA_RAG_ROOT=../lolita-rag

# ---------- LLM（规划器 + 写作器都靠它）----------
# 留空时 /api/chat 返回 503 并说明怎么配。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- 模型分级路由 ----------
# auto：按问题复杂度自动选（规则优先；规则判不出来才用便宜档做一次极小判断）。
# cheap / strong：强制走某一档——这是之后做 A/B 对比的开关（账本里会记 mode）。
MODEL_ROUTING_MODE=auto
# 两档的具体模型名；留空时回落 LLM_MODEL（只用一家模型也能跑）。
LLM_MODEL_CHEAP=
LLM_MODEL_STRONG=
# 规则判不出来时是否允许那次极小判断；失败/超时一律按便宜档兜底，不影响回答。
MODEL_ROUTING_LLM=true

# ---------- 成本核算 ----------
# 每 1K token 的单价（JSON）。不同模型单价不同，所以放配置而不是写死在代码里。
# 没配价格的模型会被标成 unpriced，金额只累计能算出来的部分，不按 0 计。
LLM_PRICE_TABLE={"deepseek-chat": {"prompt_per_1k": 0.002, "completion_per_1k": 0.008}}
LLM_PRICE_CURRENCY=CNY

# ---------- 检索 ----------
# 单通道取最相关的几条；多路召回在结果层合并，答案里的 [n] 引用与合并后的条目一一对应。
TOP_K=1
# 合并后证据条数上限（去重之后）。补查通道（xhs/weibo/web）整体豁免，实际可能略超。<=0 不限制。
EVIDENCE_MAX_ITEMS=12

# ---------- 整体预算 ----------
# 单次问答最多等多久（秒）。单通道各有超时，但总预算才是"最坏两分钟"的护栏：
# 到点返回已查到的证据 + 「部分通道超时」说明，不报 500。<=0 表示不限制。
AGENT_DEADLINE=60

# ---------- 会话记忆 ----------
# 服务端保留最近多少条消息（一问一答算 2 条）；<=0 表示不自动清理。
# 清空用 DELETE /api/chat/history。
CONVERSATION_RETENTION_MESSAGES=100

# ---------- 关注项扫描 ----------
# 单个关注项最多等多久、整轮扫描最多多久（秒）。超时的项只报 timeout，
# 不写事件、不动基线；预算用完的剩余项标记 skipped，下次扫描再查。
FOLLOW_ITEM_TIMEOUT=60
FOLLOW_CHECK_DEADLINE=120

# ---------- 后台任务队列 ----------
# 关注扫描、索引重建这类长任务入队执行：POST 立刻返回 202 + job_id，
# 用 GET /api/jobs/{id} 轮询；进度与失败原因都在任务记录里。
# 同步老接口仍在：POST /api/follows/check?wait=1。
# QUEUE_MODE=inline 时全部退回同步执行（测试 / 应急），此时队列线程不启动。
QUEUE_ENABLED=true
QUEUE_MODE=async
# HTTP 触发索引重建（POST /api/kb/rebuild）默认关闭：上游写盘不是整体原子
# （Chroma 增量持久化、manifest 最后直接 write_text），中断可能留下半成品。
# 日常仍用 python scripts/build_kb_index.py 或 docker compose run。
KB_REBUILD_API=false
KB_REBUILD_TIMEOUT=1800

# ---------- 裙子档案 ----------
# 日牌本地档案没有发售年/原价/配色时，是否在线查 Lolibrary 补详情。
# 关掉后只返回本地档案已有的字段（离线部署/测试用）。
LOLIBRARY_ONLINE=true

# ---------- 召回通道：小红书（可选）----------
# XHS_PROVIDER=playwright 时：先装 playwright，跑 python scripts/xhs_search.py --login 扫码登录。
# XHS_PROVIDER=spider_xhs 时：clone Spider_XHS 到同级目录，pip/npm 装依赖后填 XHS_COOKIE。
XHS_ENABLED=false
XHS_TIMEOUT=45
# 单次召回最多取几条（硬上限 10；关注扫描与实时交易问题可调大）
XHS_MAX_RESULTS=3
XHS_PROVIDER=playwright
# Spider_XHS 外部仓库路径（默认 ../Spider_XHS，不进本仓 git）
XHS_SPIDER_ROOT=../Spider_XHS
# 小红书登录 Cookie（需含 a1 + web_session，从浏览器请求头完整复制）
XHS_COOKIE=

# ---------- 召回通道：网页 / 微博（可选）----------
# 两个条件同时满足才启用：SEARCH_ENABLED=true 且 SEARCH_API_KEY 非空。
# weibo 通道 = 网页搜索限定微博域；web 通道 = 普通网页搜索。
# 裙子档案的中文名反查也会用这里的搜索（可选）；不启用时只走别名/拆词/模型。
SEARCH_ENABLED=false
SEARCH_API_KEY=
# 博查 bocha（默认）或智谱 zhipu
SEARCH_PROVIDER=bocha
SEARCH_BASE_URL=
SEARCH_ENGINE=search_std
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=20

# ---------- 可观测性 ----------
# data/logs/chat_runs.jsonl 超过阈值就轮转，只保留最近 N 个归档；<=0 关闭轮转。
TRACE_MAX_BYTES=5242880
TRACE_KEEP_FILES=3

# ---------- 鉴权与配额（可选，默认全关）----------
# 本地单用户默认 off：打开页面就能用，行为与以前完全一致。
# 开启后只保护 /api/*；首页、chat.js/style.css 等静态资源与 /api/health、
# /api/docs 保持公开（探针和文档不需要凭据）。
# off | api_key | jwt
AUTH_MODE=off
# api_key 模式：逗号分隔，支持 "key:展示名"。展示名只用于日志和限流分桶，
# 原始 key 不会写进日志。示例：
#   AUTH_API_KEYS=sk-local-alice:alice,sk-local-bob:bob
AUTH_API_KEYS=
# jwt 模式：签名密钥（建议 32 字节以上随机串，例如
#   python -c "import secrets;print(secrets.token_urlsafe(48))"）。
# 配好后可 POST /api/auth/token（带 X-API-Key）换取短期令牌。
AUTH_JWT_SECRET=
AUTH_JWT_TTL=3600
# 每个 key 每 RATE_LIMIT_WINDOW 秒最多 RATE_LIMIT_REQUESTS 次；
# 超限返回 429 + Retry-After。<=0 关闭（默认关闭）。
RATE_LIMIT_REQUESTS=0
RATE_LIMIT_WINDOW=60
# 每日 LLM 成本配额，单位与 LLM_PRICE_CURRENCY 一致；<=0 关闭。
# 读数复用 trace.cost_summary(days=1)，不另起一套计量；未定价模型无法配额
# （cost=None）时跳过并在日志里提示，不按 0 处理。
DAILY_QUOTA=0
