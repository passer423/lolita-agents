# lolita-agents —— 2C2G（2 GiB）低配档 .env 模板
#
# 用法：复制到服务器上的 __APP_DIR__/.env，按下面注释替换占位符后重启服务。
#   cp deploy/env/2c2g.env.example /srv/lolita-agents/.env && chmod 600 /srv/lolita-agents/.env
#
# 占位符（README 里有替换清单）：
#   __APP_DIR__        仓库目录，例如 /srv/lolita-agents
#   __LOLITA_RAG_DIR__ 上游 lolita-rag 目录，例如 /srv/lolita-rag
#   __LLM_API_KEY__    模型服务的 key，只填在服务器本地，绝不提交
#
# 本文件不含任何真实 key、cookie、密码或 IP。系统级调整（swap、swappiness、
# systemd、nginx）不在这里，见 deploy/setup-2c2g.sh 与 deploy/ 下其他文件。

# ---------- 服务绑定 ----------
# 只监听回环，外部一律经 nginx 进来；不要把 uvicorn 直接暴露到公网。
BIND_HOST=127.0.0.1
BIND_PORT=8787

# ---------- 数据与上游路径 ----------
# 必须用绝对路径：systemd 的 WorkingDirectory 变化时相对路径会漂。
DATA_DIR=__APP_DIR__/data
# 必须是固定 checkout，不要指向临时目录，否则两份索引都会建不出来。
LOLITA_RAG_ROOT=__LOLITA_RAG_DIR__

# ---------- LLM ----------
LLM_API_KEY=__LLM_API_KEY__
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- 2C2G 档：把单次请求压小 ----------
# 每个通道只取 1 条：少一条证据就少一段 prompt，直接省内存与 token。
TOP_K=1
# 合并后证据上限从默认 12 降到 8：2 GiB 上单次 prompt 越小越稳。
EVIDENCE_MAX_ITEMS=8
# 写作输出上限从 1800 降到 1200：长回答不是这档能承受的主要成本，先保不 OOM。
WRITER_MAX_TOKENS=1200
# 整体预算从 60s 降到 45s：缩短单次占用内存的时间窗，也配合 nginx 读超时。
AGENT_DEADLINE=45

# ---------- 精排（已实测，默认开启） ----------
# int8 ONNX（data/models/bge-reranker-base/onnx/model.int8.onnx，266 MB）在 2C2G
# 实测：单次问答 RSS 1567 MB、峰值 VmHWM 1580 MB、无 OOM，闲置 120 秒自动卸载
# 回落到约 1.2 GB。缺 onnxruntime 或模型文件时回退 fp32 torch（常驻约 1 GB），
# 2 GiB 机器上不要走那条回退路。
RERANKER_ENABLED=true

# ---------- 启动预热 ----------
# 打开后，启动即在后台线程跑一次最小检索（不调 LLM），把 BGE 与精排加载进内存。
# 代价：开机后约 25 秒才预热完（服务此时已可访问），空载常驻内存从约 160 MB
# 升到约 1.2 GB（精排 120 秒闲置后仍会计时卸载）；收益：公网首问从约 30 秒
# 降到 10 秒以内。内存吃紧或只做接口压测时改回 false。
WARMUP_ON_START=true

# ---------- 仍然关闭的可选重功能 ----------
# OCR 在配置里的默认值是 true，必须显式写 false 才算关掉。
# 关掉后「价格标在图上」这类问题会少一类证据，但不影响主链路。
OCR_ENABLED=false
# 如果演示必须保留 OCR（与微博直抓二选一，推荐 OCR），改用下面这组小预算：
# OCR_ENABLED=true
# OCR_MAX_ITEMS=2
# OCR_IMAGES_PER_ITEM=1
# OCR_TOTAL_BUDGET=6

# 微博直抓要起 Chromium（约 300 MB）+ 系统依赖（约 200 MB）+ 每上下文 300–500 MB，
# 与模型同时存在基本没有余量，关掉。
WEIBO_DIRECT_ENABLED=false

# 品牌范围：jp = 线上只做日牌（国牌的品牌条目、别名、xhs 账号仍留在数据文件里，
# 但不参与识别与检索）；all = 全开。评测里 scope=cn 的条目会跳过并单列。
BRAND_SCOPE=jp

# 小红书是另一套浏览器自动化，服务器上没有登录态，关掉。
XHS_ENABLED=false

# 网页作为最后手段兜底时的硬超时（秒）；官网/微博都空才会走到这里。
WEB_FALLBACK_TIMEOUT=6

# 带 key 的搜索通道：无本地模型但会拉长单次请求，演示不需要，关掉。
SEARCH_ENABLED=false

# 无 key 网页来源（Bing/360）同样要起浏览器内核，一并关掉。
WEB_BROWSER_ENABLED=false

# ---------- 成本护栏（与内存无关，但对外演示建议保留） ----------
# 应用层按 IP 的限流；nginx 已经压到 6 次/分钟，这里是第二道。
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60
# 每日成本上限（币种由 LLM_PRICE_CURRENCY 决定）；未定价模型会跳过配额检查。
DAILY_QUOTA=20
LLM_PRICE_TABLE={"deepseek-chat": {"prompt_per_1k": 0.002, "completion_per_1k": 0.008}}
LLM_PRICE_CURRENCY=CNY

# ---------- 访问控制（按需填写，默认全关） ----------
# 网页端不发凭据头，应用层 api_key/jwt 会让页面 401；对外演示请用 nginx basic auth，
# 这里保持 off。
AUTH_MODE=off
